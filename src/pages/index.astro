---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const base = import.meta.env.BASE_URL;
const title = 'watanabe3tipapa | Bricoleur & Toolsmith';
const description = 'Toru Watanabe の制作・研究・ドキュメントをつなぐ個人ポータルです。';

const destinations = [
  {
    eyebrow: '01 / CATALOG',
    title: 'All sites & services',
    description: '公開中のサイト、サービス、制作物を横断して確認する最新の一覧です。',
    href: 'https://watanabe3tipapa.github.io/index/',
  },
  {
    eyebrow: '02 / DOCUMENTATION',
    title: 'next',
    description: '公開経路、設計判断、Quarto・GitHub Pagesの運用を記録する構築ノートです。',
    href: 'https://next.watanabe3ti.com/',
  },
  {
    eyebrow: '03 / WORKS',
    title: 'Projects',
    description: 'CLI、スクリプト、Webサイト、教材など、実用的な道具づくりの記録です。',
    href: 'https://watanabe3tipapa.github.io/projects/project.html',
  },
  {
    eyebrow: '04 / SOURCE',
    title: 'GitHub',
    description: 'ソースコード、設定、実験的な取り組みを公開しています。',
    href: 'https://github.com/watanabe3tipapa',
  },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header />
    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Independent maker / Hokkaido, Japan</p>
          <h1 id="hero-title">ありあわせから、<br />役に立つ道具を。</h1>
          <p class="lead">
            <strong>Bricoleur &amp; Toolsmith</strong> として、ターミナル操作、CLIツール、Webサイト、教材、自由研究を横断しながら、必要なものを必要なだけつくっています。
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="https://watanabe3tipapa.github.io/index/" target="_blank" rel="noreferrer">
              公開サイト一覧へ <span aria-hidden="true">↗</span>
            </a>
            <a class="button button-quiet" href={`${base}/about/`}>活動について</a>
          </div>
        </div>
        <div class="signal-card" aria-label="現在の活動領域">
          <p class="signal-label">WORKING AREA</p>
          <p class="signal-value">Make<br />Learn<br />Share</p>
          <dl>
            <div><dt>Tools</dt><dd>CLI / scripts</dd></div>
            <div><dt>Web</dt><dd>Sites / services</dd></div>
            <div><dt>Workshop</dt><dd>Terminal no Shiwaza</dd></div>
          </dl>
        </div>
      </section>

      <section class="section" aria-labelledby="destinations-title">
        <div class="section-heading">
          <p class="eyebrow">Explore</p>
          <h2 id="destinations-title">制作と記録への入口</h2>
          <p>このリポジトリは、個人としての活動を案内する入口です。現在の公開資産は一覧へ、設計・運用の背景はnextへつなぎます。</p>
        </div>
        <div class="destination-grid">
          {destinations.map((destination) => (
            <a class="destination" href={destination.href} target="_blank" rel="noreferrer">
              <p class="destination-eyebrow">{destination.eyebrow}</p>
              <h3>{destination.title}<span aria-hidden="true">↗</span></h3>
              <p>{destination.description}</p>
            </a>
          ))}
        </div>
      </section>

      <section class="principle" aria-labelledby="principle-title">
        <p class="eyebrow">Principle</p>
        <h2 id="principle-title">使えること、続けられること、<br />共有できること。</h2>
        <p>
          複雑な仕組みを目的にせず、手元にある技術を組み合わせ、次の一歩を少し楽にするための仕組みを考えます。つくった過程と成果は、できる限りオープンに残します。
        </p>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    max-width: 1120px;
    margin: 0 auto;
    padding: 4.5rem 1.5rem 0;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(17rem, 0.55fr);
    gap: 2.5rem;
    align-items: end;
    min-height: 30rem;
    padding: 2.5rem 0 4.5rem;
  }

  .eyebrow,
  .destination-eyebrow,
  .signal-label {
    display: inline-block;
    margin-bottom: 1rem;
    padding: 0.3rem 0.55rem;
    border: 2px solid var(--ink);
    color: var(--ink);
    background: var(--warm);
    box-shadow: 3px 3px 0 var(--ink);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 53rem;
    margin-bottom: 1.75rem;
    color: var(--ink);
    font-size: clamp(2.55rem, 6.5vw, 5.25rem);
  }

  h1::selection {
    background: var(--warm);
  }

  .lead {
    max-width: 45rem;
    margin-bottom: 2rem;
    color: var(--muted);
    font-size: clamp(1rem, 1.7vw, 1.2rem);
  }

  .lead strong {
    color: var(--ink);
    font-weight: 800;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.2rem;
    padding: 0.85rem 1.05rem;
    border: 3px solid var(--ink);
    border-radius: 0;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 5px 5px 0 var(--ink);
    transition: transform 120ms ease, box-shadow 120ms ease, background 120ms ease;
  }

  .button:hover {
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 var(--ink);
  }

  .button:active {
    transform: translate(3px, 3px);
    box-shadow: 0 0 0 var(--ink);
  }

  .button-primary {
    color: var(--surface-raised);
    background: var(--accent);
  }

  .button-primary:hover {
    color: var(--surface-raised);
    background: var(--accent-deep);
  }

  .button-quiet {
    border-color: var(--ink);
    color: var(--ink);
    background: var(--surface-raised);
  }

  .signal-card {
    position: relative;
    overflow: hidden;
    padding: 1.75rem;
    border: 3px solid var(--ink);
    border-radius: 0;
    background: var(--mint);
    box-shadow: 8px 8px 0 var(--ink);
    transform: rotate(2deg);
  }

  .signal-card::after {
    position: absolute;
    right: -3rem;
    bottom: -3rem;
    width: 8rem;
    height: 8rem;
    border: 1.5rem solid rgb(17 17 17 / 15%);
    border-radius: 50%;
    content: '';
  }

  .signal-value {
    position: relative;
    z-index: 1;
    margin-bottom: 1.75rem;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  dl {
    position: relative;
    z-index: 1;
    margin: 0;
  }

  dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0;
    border-top: 2px dashed var(--ink);
    font-family: var(--font-mono);
    font-size: 0.69rem;
  }

  dt { color: var(--ink); font-weight: 700; }
  dd { margin: 0; color: var(--muted); text-align: right; }

  .section {
    padding: 4.5rem 0;
    border-top: 3px solid var(--ink);
  }

  .section-heading {
    display: grid;
    grid-template-columns: 1fr minmax(18rem, 1.5fr);
    gap: 1rem 2rem;
    align-items: end;
    margin-bottom: 2rem;
  }

  .section-heading .eyebrow {
    grid-column: 1 / -1;
    margin-bottom: 0;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.65rem, 3.2vw, 2.55rem);
  }

  .section-heading > p:last-child {
    max-width: 38rem;
    margin: 0;
    color: var(--muted);
  }

  .destination-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 3px solid var(--ink);
    border-left: 3px solid var(--ink);
  }

  .destination {
    position: relative;
    min-height: 14rem;
    padding: 1.5rem;
    border-right: 3px solid var(--ink);
    border-bottom: 3px solid var(--ink);
    color: var(--ink);
    background: var(--surface-raised);
    text-decoration: none;
    transition: background 140ms ease, transform 140ms ease, box-shadow 140ms ease;
  }

  .destination:hover {
    color: var(--ink);
    background: var(--accent-soft);
    box-shadow: 6px 6px 0 var(--ink);
    transform: translate(-4px, -4px);
    z-index: 1;
  }

  .destination-eyebrow {
    margin-bottom: 2.5rem;
    color: var(--ink);
    font-size: 0.65rem;
  }

  .destination h3 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }

  .destination h3 span {
    color: var(--accent-deep);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .destination > p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .principle {
    max-width: 50rem;
    padding: 3rem 2rem 3.5rem;
    margin: 5rem 0 1rem;
    border: 3px solid var(--ink);
    background: var(--warm);
    box-shadow: 8px 8px 0 var(--ink);
  }

  .principle h2 {
    margin-bottom: 1.5rem;
  }

  .principle > p:last-child {
    max-width: 43rem;
    margin-bottom: 0;
    color: var(--muted);
    font-size: 1.05rem;
  }

  @media (max-width: 760px) {
    main { padding: 2.5rem 1rem 0; }
    .hero { grid-template-columns: 1fr; gap: 2rem; min-height: auto; padding: 1.5rem 0 3rem; }
    .signal-card { max-width: 28rem; }
    .section { padding: 3rem 0; }
    .section-heading { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    .destination-grid { grid-template-columns: 1fr; }
    .hero-actions .button { width: 100%; }
  }
</style>
