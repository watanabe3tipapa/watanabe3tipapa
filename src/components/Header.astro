---
const base = import.meta.env.BASE_URL;
const { pathname } = Astro.url;

const navigation = [
  { label: 'Portal', href: `${base}/` },
  { label: 'About', href: `${base}/about/` },
];
---

<header>
  <nav class="nav-shell" aria-label="主要ナビゲーション">
    <a class="brand" href={`${base}/`} aria-label="watanabe3tipapa ポータルのトップへ">
      <span class="brand-mark">W3</span>
      <span>
        <strong>watanabe3tipapa</strong>
        <small>Bricoleur &amp; Toolsmith</small>
      </span>
    </a>

    <div class="nav-links">
      {navigation.map((item) => (
        <a href={item.href} aria-current={pathname === item.href ? 'page' : undefined}>{item.label}</a>
      ))}
      <a href="https://watanabe3tipapa.github.io/" target="_blank" rel="noreferrer">
        Main site <span aria-hidden="true">↗</span>
      </a>
    </div>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 3px solid var(--ink);
    background: var(--warm);
    box-shadow: 0 3px 0 #fff, 0 6px 0 var(--ink);
  }

  .nav-shell {
    display: flex;
    max-width: 1120px;
    min-height: 4.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin: 0 auto;
    padding: 0.5rem 1.5rem;
  }

  .brand,
  .nav-links {
    display: flex;
    align-items: center;
  }

  .brand {
    gap: 0.75rem;
    color: var(--ink);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--ink);
  }

  .brand-mark {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 3px solid var(--ink);
    border-radius: 0;
    color: var(--ink);
    background: var(--surface-raised);
    box-shadow: 3px 3px 0 var(--ink);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    transform: rotate(-6deg);
  }

  .brand strong,
  .brand small {
    display: block;
  }

  .brand strong {
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }

  .brand small {
    margin-top: 0.1rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.03em;
  }

  .nav-links {
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.6rem;
  }

  .nav-links a {
    padding: 0.5rem 0.7rem;
    border: 2px solid var(--ink);
    border-radius: 0;
    color: var(--ink);
    background: var(--surface-raised);
    box-shadow: 3px 3px 0 var(--ink);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 120ms ease, transform 120ms ease, box-shadow 120ms ease;
  }

  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--ink);
    background: var(--accent-soft);
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .nav-links a[aria-current='page'] {
    background: var(--accent);
    color: var(--surface-raised);
  }

  @media (max-width: 620px) {
    .nav-shell {
      min-height: 4.25rem;
      padding: 0.45rem 1rem;
    }

    .brand small,
    .nav-links a:last-child {
      display: none;
    }
  }
</style>
