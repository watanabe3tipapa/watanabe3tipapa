---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer>
  <div class="footer-shell">
    <div>
      <p class="footer-title">watanabe3tipapa</p>
      <p class="footer-note">Bricoleur &amp; Toolsmith · 小樽・北海道</p>
    </div>
    <div class="footer-links" aria-label="補助リンク">
      <a href="https://github.com/watanabe3tipapa" target="_blank" rel="noreferrer">GitHub</a>
      <a href="https://gist.github.com/watanabe3tipapa" target="_blank" rel="noreferrer">Gist</a>
      <a href="https://watanabe3tipapa.github.io/" target="_blank" rel="noreferrer">Main site</a>
      <a href={`${base}/about/`}>About</a>
    </div>
  </div>
  <div class="footer-shell footer-bottom">
    <small>© {year} watanabe3tipapa</small>
    <small>Built with Astro · Hosted on GitHub Pages</small>
  </div>
</footer>

<style>
  footer {
    margin-top: 5rem;
    border-top: 1px solid var(--line);
    background: var(--surface-raised);
  }

  .footer-shell {
    display: flex;
    max-width: 1120px;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .footer-title,
  .footer-note {
    margin: 0;
  }

  .footer-title {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .footer-note,
  small {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .footer-note {
    margin-top: 0.35rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
  }

  .footer-links a {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    padding-top: 1rem;
    padding-bottom: 1.25rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 620px) {
    .footer-shell {
      display: block;
      padding: 1.5rem 1rem;
    }

    .footer-links {
      margin-top: 1.25rem;
    }

    .footer-bottom small {
      display: block;
      margin-top: 0.4rem;
    }
  }
</style>
